{
  "controller_type": "knuckles",
  "name": "tide vr spike",
  "description": "stick clicks for the summon backup, both hand skeletons, raw poses, haptics",
  "bindings": {
    "/actions/tide": {
      "sources": [
        {
          "path": "/user/hand/left/input/thumbstick",
          "mode": "button",
          "inputs": { "click": { "output": "/actions/tide/in/stick_left" } }
        },
        {
          "path": "/user/hand/right/input/thumbstick",
          "mode": "button",
          "inputs": { "click": { "output": "/actions/tide/in/stick_right" } }
        }
      ],
      "skeleton": [
        { "output": "/actions/tide/in/hand_left", "path": "/user/hand/left/input/skeleton/left" },
        { "output": "/actions/tide/in/hand_right", "path": "/user/hand/right/input/skeleton/right" }
      ],
      "poses": [
        { "output": "/actions/tide/in/pose_left", "path": "/user/hand/left/pose/raw" },
        { "output": "/actions/tide/in/pose_right", "path": "/user/hand/right/pose/raw" }
      ],
      "haptics": [
        { "output": "/actions/tide/out/haptic", "path": "/user/hand/left/output/haptic" },
        { "output": "/actions/tide/out/haptic", "path": "/user/hand/right/output/haptic" }
      ]
    }
  }
}
