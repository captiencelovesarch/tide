/*[if doc]*/
/* tide :: _base.qss — the one structural stylesheet behind every bundled  */
/* theme. A theme.toml that declares `uses_base = true` under [meta] gets  */
/* this file (dialect-resolved, see below) prepended to whatever its own   */
/* theme.qss holds — for the bundled themes that overlay is empty, because */
/* their entire palette lives in [tokens] and @token substitution does the */
/* rest. Third-party themes may declare uses_base too and append palette   */
/* overrides after these rules; themes WITHOUT the flag keep shipping a    */
/* full standalone theme.qss exactly as before.                            */
/*                                                                         */
/* Dialect markers: a whole line reading [if brutalist] or [if modern]     */
/* (each wrapped in its own comment, like the markers around this block)   */
/* keeps the lines up to the next [endif] line only when the theme's       */
/* [meta] aesthetic matches; marker lines themselves never reach Qt. No    */
/* nesting. This header block is tagged "doc" — no aesthetic is called     */
/* that, so the loader always strips it.                                   */
/*                                                                         */
/* @banner on the next line resolves from each theme's [tokens] banner.    */
/*[endif]*/
/* tide :: @banner */

* {
/*[if brutalist]*/
    font-family: "@font_family";
/*[endif]*/
/*[if modern]*/
    font-family: "@font_family", "IBM Plex Sans", sans-serif;
/*[endif]*/
    font-size: @font_size;
    color: @fg;
}

QMainWindow, QDialog, QWidget {
    background: @bg;
    color: @fg;
}
QWidget:focus { outline: 0; }

QLabel { background: transparent; color: @fg; }
QLabel#dim, QLabel.dim { color: @dim; }
QLabel#accent, QLabel.accent { color: @accent; }
/*[if modern]*/
QLabel.title { font-size: @font_size_title; font-weight: @weight_title; }
QLabel.display { font-size: @font_size_display; font-weight: @weight_display; }
/*[endif]*/

/* ---------- inputs ---------- */
QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QDoubleSpinBox {
/*[if brutalist]*/
    background: @bg;
/*[endif]*/
/*[if modern]*/
    background: @surface_1;
/*[endif]*/
    color: @fg;
/*[if brutalist]*/
    border: @border solid @border_col;
/*[endif]*/
/*[if modern]*/
    border: @border solid @outline;
/*[endif]*/
    border-radius: @radius;
/*[if brutalist]*/
    padding: 6px 10px;
    selection-background-color: @sel_bg;
    selection-color: @sel_fg;
/*[endif]*/
/*[if modern]*/
    padding: 8px 14px;
    selection-background-color: @accent;
    selection-color: @bg;
/*[endif]*/
}
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus,
QSpinBox:focus, QDoubleSpinBox:focus { border-color: @accent; }
QLineEdit:disabled, QTextEdit:disabled, QPlainTextEdit:disabled,
/*[if brutalist]*/
QSpinBox:disabled, QDoubleSpinBox:disabled { color: @dim; border-color: @border_dim; }
/*[endif]*/
/*[if modern]*/
QSpinBox:disabled, QDoubleSpinBox:disabled { color: @dim; }
/*[endif]*/

QSpinBox::up-button, QDoubleSpinBox::up-button,
QSpinBox::down-button, QDoubleSpinBox::down-button {
    background: transparent;
    border: none;
/*[if brutalist]*/
    width: 14px;
/*[endif]*/
/*[if modern]*/
    width: 16px;
/*[endif]*/
}

/* ---------- buttons ---------- */
QPushButton, QToolButton {
/*[if brutalist]*/
    background: @bg;
/*[endif]*/
/*[if modern]*/
    background: @surface_1;
/*[endif]*/
    color: @fg;
/*[if brutalist]*/
    border: @border solid @border_col;
/*[endif]*/
/*[if modern]*/
    border: @border solid @outline;
/*[endif]*/
    border-radius: @radius;
/*[if brutalist]*/
    padding: 4px 12px;
/*[endif]*/
/*[if modern]*/
    padding: 6px 14px;
/*[endif]*/
}
/*[if brutalist]*/
QPushButton:hover, QToolButton:hover { background: @sel_bg; color: @sel_fg; }
QPushButton:pressed, QToolButton:pressed { background: @accent; color: @bg; }
QPushButton:disabled, QToolButton:disabled { color: @dim; border-color: @border_dim; }
/*[endif]*/
/*[if modern]*/
QPushButton:hover, QToolButton:hover { background: @surface_2; color: @hover_fg; border-color: @outline; }
QPushButton:pressed, QToolButton:pressed { background: @sel_bg; color: @sel_fg; }
QPushButton:disabled, QToolButton:disabled { color: @dim; }
/*[endif]*/
QPushButton:focus, QToolButton:focus { border-color: @accent; }
QToolButton::menu-indicator { image: none; }
/*[if modern]*/

/* ---------- BracketButton, the modern face ---------- */
/* brutalist styles this widget inline: bracketed text, inverting hover.
   modern hands it to the sheet: bare labels on a translucent surface, an
   SVG icon where the action has one. The widget sets `role`: pill (text,
   the default), icon (icon only), transport (the strip's play row), row
   (the nav rail). `primary` is the play button; `current` the rail's
   active view. */
QPushButton#BracketButton {
    background: transparent;
    color: @fg;
    border: 0;
    border-radius: @radius;
    padding: 6px 12px;
}
QPushButton#BracketButton:hover { background: @surface_2; color: @fg; }
QPushButton#BracketButton:pressed { background: @surface_3; }
QPushButton#BracketButton:disabled { color: @dim; background: transparent; }
QPushButton#BracketButton[activeState="true"] { color: @accent; }
QPushButton#BracketButton[role="pill"] { background: @surface_1; padding: 6px 14px; }
QPushButton#BracketButton[role="pill"]:hover { background: @surface_2; }
QPushButton#BracketButton[role="pill"][activeState="true"] { background: @surface_2; color: @accent; }
QPushButton#BracketButton[role="icon"],
QPushButton#BracketButton[role="transport"] { padding: 6px; }
QPushButton#BracketButton[role="row"] { text-align: left; padding: 8px 12px; }
QPushButton#BracketButton[role="row"][current="true"] { background: @surface_2; color: @accent; }
QPushButton#BracketButton[primary="true"] {
    background: @fg;
    color: @bg;
    border-radius: @radius_round;
    padding: 10px;
}
QPushButton#BracketButton[primary="true"]:hover { background: @accent; color: @bg; }
QPushButton#BracketButton[primary="true"]:disabled { background: @surface_2; }
/*[endif]*/

/*[if brutalist]*/
QDialogButtonBox QPushButton { min-width: 80px; }
/*[endif]*/
/*[if modern]*/
QDialogButtonBox QPushButton { min-width: 90px; }
/*[endif]*/

/* ---------- checkbox / radio ---------- */
QCheckBox, QRadioButton {
    background: transparent;
    color: @fg;
/*[if brutalist]*/
    spacing: 8px;
/*[endif]*/
/*[if modern]*/
    spacing: 10px;
/*[endif]*/
    padding: 2px 0;
}
/*[if brutalist]*/
QCheckBox::indicator, QRadioButton::indicator {
    width: 14px;
    height: 14px;
/*[endif]*/
/*[if modern]*/
QCheckBox::indicator {
    width: 16px;
    height: 16px;
/*[endif]*/
    border: @border solid @border_col;
/*[if brutalist]*/
    background: @bg;
/*[endif]*/
/*[if modern]*/
    background: @surface_1;
    border-radius: 4px;
/*[endif]*/
}
/*[if brutalist]*/
QCheckBox::indicator { border-radius: 0; }
QRadioButton::indicator { border-radius: 0; }
/*[endif]*/
/*[if modern]*/
QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border: @border solid @border_col;
    background: @surface_1;
    border-radius: 8px;
}
/*[endif]*/
QCheckBox::indicator:hover, QRadioButton::indicator:hover { border-color: @accent; }
QCheckBox::indicator:checked {
    background: @accent;
    border-color: @accent;
}
QRadioButton::indicator:checked {
    background: @accent;
    border-color: @accent;
}
QCheckBox::indicator:disabled, QRadioButton::indicator:disabled {
    border-color: @border_dim;
/*[if brutalist]*/
    background: @bg;
/*[endif]*/
/*[if modern]*/
    background: @surface_1;
/*[endif]*/
}
QCheckBox:disabled, QRadioButton:disabled { color: @dim; }

/* ---------- combo box ---------- */
QComboBox {
/*[if brutalist]*/
    background: @bg;
/*[endif]*/
/*[if modern]*/
    background: @surface_1;
/*[endif]*/
    color: @fg;
/*[if brutalist]*/
    border: @border solid @border_col;
/*[endif]*/
/*[if modern]*/
    border: @border solid @outline;
/*[endif]*/
    border-radius: @radius;
/*[if brutalist]*/
    padding: 4px 8px;
/*[endif]*/
/*[if modern]*/
    padding: 6px 10px;
/*[endif]*/
}
/*[if brutalist]*/
QComboBox:hover { border-color: @accent; }
/*[endif]*/
/*[if modern]*/
QComboBox:hover { border-color: @border_col; }
/*[endif]*/
QComboBox:focus { border-color: @accent; }
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
/*[if brutalist]*/
    width: 18px;
    border-left: @border solid @border_col;
/*[endif]*/
/*[if modern]*/
    width: 22px;
    border-left: 0;
/*[endif]*/
}
QComboBox::down-arrow { image: none; }
QComboBox QAbstractItemView {
/*[if brutalist]*/
    background: @bg;
/*[endif]*/
/*[if modern]*/
    background: @bg_alt;
/*[endif]*/
    color: @fg;
    selection-background-color: @sel_bg;
    selection-color: @sel_fg;
    border: @border solid @border_col;
/*[if modern]*/
    border-radius: @radius;
/*[endif]*/
    outline: 0;
/*[if brutalist]*/
    padding: 2px 0;
/*[endif]*/
/*[if modern]*/
    padding: 4px 0;
/*[endif]*/
}
/*[if modern]*/
QComboBox QAbstractItemView::item { padding: 6px 12px; }
/*[endif]*/

/* ---------- slider ---------- */
/* Grooves are thick on both sides of the split — a hairline bar is a
   worse target and reads as a divider. Each personality keeps its own
   shape language: brutalist stays a square block meter, modern is a pill
   matching the SpringSlider it sits beside. */
QSlider::groove:horizontal {
/*[if brutalist]*/
    height: 12px;
    border: 0;
/*[endif]*/
/*[if modern]*/
    height: 14px;
    border-radius: 7px;
/*[endif]*/
    background: @border_dim;
}
QSlider::handle:horizontal {
    background: @fg;
/*[if brutalist]*/
    border: @border solid @border_col;
    width: 10px;
    height: 18px;
    margin: -3px 0;
/*[endif]*/
/*[if modern]*/
    border: 0;
    width: 20px;
    height: 20px;
    margin: -3px 0;
    border-radius: 10px;
/*[endif]*/
}
QSlider::handle:horizontal:hover { background: @accent; }
/*[if brutalist]*/
QSlider::sub-page:horizontal { background: @accent; }
/*[endif]*/
/*[if modern]*/
QSlider::sub-page:horizontal { background: @accent; border-radius: 7px; }
/*[endif]*/

/* ---------- group box ---------- */
QGroupBox {
    background: transparent;
    border: @border solid @border_dim;
    border-radius: @radius;
    margin-top: 14px;
/*[if brutalist]*/
    padding: 8px;
/*[endif]*/
/*[if modern]*/
    padding: 10px;
/*[endif]*/
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
/*[if brutalist]*/
    padding: 0 6px;
/*[endif]*/
/*[if modern]*/
    padding: 0 8px;
/*[endif]*/
    color: @dim;
}

/* ---------- tabs ---------- */
QTabWidget::pane {
    background: @bg;
/*[if brutalist]*/
    border: @border solid @border_col;
/*[endif]*/
/*[if modern]*/
    border: @border solid @border_dim;
/*[endif]*/
    border-radius: @radius;
}
QTabBar::tab {
/*[if brutalist]*/
    background: @bg;
/*[endif]*/
/*[if modern]*/
    background: transparent;
/*[endif]*/
    color: @dim;
/*[if brutalist]*/
    border: @border solid @border_col;
    border-bottom: 0;
    padding: 6px 14px;
    margin-right: 2px;
/*[endif]*/
/*[if modern]*/
    border: 0;
    padding: 8px 16px;
    margin-right: 4px;
    border-radius: @radius;
/*[endif]*/
}
QTabBar::tab:selected { color: @fg; background: @bg_alt; }
QTabBar::tab:hover { color: @fg; }

/* ---------- list / tree views ---------- */
QListView, QListWidget, QTreeView {
    background: @bg;
    color: @fg;
/*[if brutalist]*/
    border: @border solid @border_col;
    border-radius: @radius;
/*[endif]*/
/*[if modern]*/
    border: 0;
/*[endif]*/
    outline: 0;
    padding: 4px 0;
}
QListView::item, QListWidget::item, QTreeView::item {
/*[if brutalist]*/
    padding: 4px 10px;
    border: none;
/*[endif]*/
/*[if modern]*/
    padding: 8px 14px;
    border-radius: 6px;
    margin: 2px 4px;
    border: 0;
/*[endif]*/
}
QListView::item:hover, QListWidget::item:hover, QTreeView::item:hover {
    background: @hover_bg;
}
QListView::item:selected, QListWidget::item:selected, QTreeView::item:selected {
    background: @sel_bg;
    color: @sel_fg;
}
QListView::item:focus { border: 0; }

QHeaderView::section {
/*[if brutalist]*/
    background: @bg;
/*[endif]*/
/*[if modern]*/
    background: transparent;
/*[endif]*/
    color: @dim;
    border: 0;
    border-bottom: @border solid @border_dim;
/*[if brutalist]*/
    padding: 6px 10px;
/*[endif]*/
/*[if modern]*/
    padding: 8px 12px;
/*[endif]*/
}

/* ---------- scroll area + scrollbars ---------- */
QScrollArea {
    background: @bg;
    border: 0;
}
QAbstractScrollArea > QWidget > QWidget { background: @bg; }

/*[if brutalist]*/
QScrollBar:vertical {
    background: @bg;
    width: 8px;
/*[endif]*/
/*[if modern]*/
QScrollBar:vertical, QScrollBar:horizontal {
    background: transparent;
    width: 10px;
    height: 10px;
/*[endif]*/
    margin: 0;
    border: 0;
}
/*[if brutalist]*/
QScrollBar::handle:vertical {
    background: @border_dim;
    min-height: 24px;
    border-radius: 0;
/*[endif]*/
/*[if modern]*/
QScrollBar::handle:vertical, QScrollBar::handle:horizontal {
    background: @border_col;
    border-radius: 5px;
    min-height: 30px;
    min-width: 30px;
/*[endif]*/
}
/*[if brutalist]*/
QScrollBar::handle:vertical:hover { background: @dim; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; background: transparent; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: transparent; }

QScrollBar:horizontal {
    background: @bg;
    height: 8px;
    margin: 0;
    border: 0;
}
QScrollBar::handle:horizontal {
    background: @border_dim;
    min-width: 24px;
    border-radius: 0;
}
QScrollBar::handle:horizontal:hover { background: @dim; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; background: transparent; }
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal { background: transparent; }
/*[endif]*/
/*[if modern]*/
QScrollBar::handle:hover { background: @dim; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; background: transparent; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }
/*[endif]*/

/* ---------- status bar ---------- */
QStatusBar { background: @bg; color: @dim; border: 0; }
QStatusBar::item { border: 0; }

/* ---------- tooltips ---------- */
QToolTip {
/*[if brutalist]*/
    background: @bg;
/*[endif]*/
/*[if modern]*/
    background: @bg_alt;
/*[endif]*/
    color: @fg;
    border: @border solid @border_col;
/*[if brutalist]*/
    padding: 4px 6px;
    border-radius: 0;
/*[endif]*/
/*[if modern]*/
    padding: 6px 10px;
    border-radius: @radius;
/*[endif]*/
}

/* ---------- right-click menus ---------- */
QMenu {
/*[if brutalist]*/
    background: @bg;
/*[endif]*/
/*[if modern]*/
    background: @bg_alt;
/*[endif]*/
    color: @fg;
    border: @border solid @border_col;
    border-radius: @radius;
/*[if brutalist]*/
    padding: 4px 0;
/*[endif]*/
/*[if modern]*/
    padding: 6px 0;
/*[endif]*/
}
/*[if brutalist]*/
QMenu::item { padding: 5px 16px; background: transparent; }
/*[endif]*/
/*[if modern]*/
QMenu::item { padding: 7px 22px; background: transparent; border-radius: 0; }
/*[endif]*/
QMenu::item:selected { background: @sel_bg; color: @sel_fg; }
/*[if brutalist]*/
QMenu::separator { height: 1px; background: @border_dim; margin: 4px 0; }
QMenu::icon { padding-left: 6px; }
/*[endif]*/
/*[if modern]*/
QMenu::separator { height: 1px; background: @border_dim; margin: 4px 8px; }
QMenu::icon { padding-left: 8px; }
/*[endif]*/

/* ---------- now-playing strip + nav rail ---------- */
QFrame#now_playing {
/*[if brutalist]*/
    background: @bg;
/*[endif]*/
/*[if modern]*/
    background: @bg_alt;
/*[endif]*/
    border-top: @border solid @border_col;
}
QFrame#nav {
/*[if brutalist]*/
    background: @bg;
    border-right: @border solid @border_col;
/*[endif]*/
/*[if modern]*/
    background: @bg_alt;
    border-right: 0;   /* modern themes: no nav divider */
/*[endif]*/
}
