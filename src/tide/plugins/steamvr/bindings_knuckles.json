{
  "controller_type": "knuckles",
  "name": "tide",
  "description": "hand skeletons, raw hand poses and haptics for tide's vr panel",
  "bindings": {
    "/actions/tide": {
      "skeleton": [
        {
          "output": "/actions/tide/in/hand_left",
          "path": "/user/hand/left/input/skeleton/left"
        },
        {
          "output": "/actions/tide/in/hand_right",
          "path": "/user/hand/right/input/skeleton/right"
        }
      ],
      "poses": [
        {
          "output": "/actions/tide/in/pose_left",
          "path": "/user/hand/left/pose/raw"
        },
        {
          "output": "/actions/tide/in/pose_right",
          "path": "/user/hand/right/pose/raw"
        }
      ],
      "haptics": [
        {
          "output": "/actions/tide/out/haptic",
          "path": "/user/hand/left/output/haptic"
        },
        {
          "output": "/actions/tide/out/haptic",
          "path": "/user/hand/right/output/haptic"
        }
      ]
    }
  }
}